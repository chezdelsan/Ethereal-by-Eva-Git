# Ethereal by Eva Environment Variables
# Copy this file to .env and fill in your values

# Database (leave empty for SQLite in development)
DATABASE_URL=

# Stripe (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Shippo (get from https://apps.goshippo.com/settings/api)
SHIPPO_API_KEY=shippo_test_your_key_here

# Admin password for accessing /admin panel
ADMIN_PASSWORD=change-this-to-something-secure

# Email (Resend - get from https://resend.com)
RESEND_API_KEY=re_your_key_here
FROM_EMAIL=orders@yourdomain.com

# Your notification email (where to send new order alerts)
ADMIN_EMAIL=your-email@example.com

# Shipping origin
SHIP_FROM_NAME=Ethereal by Eva
SHIP_FROM_STREET=1 Ohio University
SHIP_FROM_CITY=Athens
SHIP_FROM_STATE=OH
SHIP_FROM_ZIP=45701
SHIP_FROM_COUNTRY=US
